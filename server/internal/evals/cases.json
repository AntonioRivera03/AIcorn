          "expected": [
            "2024-02-28",
            "2024-02-29",
            "2024-03-01"
          ]
        },
        {
          "input": {
            "start": "2025-01-02",
            "end": "2025-01-01"
          },
          "expected": []
        },
        {
          "input": {
            "start": "2025-12-31",
            "end": "2026-01-01"
          },
          "expected": [
            "2025-12-31",
            "2026-01-01"
          ]
        }
      ]
    },
